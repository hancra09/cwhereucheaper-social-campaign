[Unit]
Description=Select supported viewer requests and prioritise them at the daily reset

[Timer]
OnCalendar=*-*-* *:25,55:00
# 00:01 SAST: give a waiting request the first available daily render.
OnCalendar=*-*-* 22:01:00 UTC
Persistent=true
Unit=cwhereu-viewer-requests.service

[Install]
WantedBy=timers.target
