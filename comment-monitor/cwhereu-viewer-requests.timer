[Unit]
Description=Select supported viewer requests and prioritise them at the daily reset

[Timer]
OnCalendar=*-*-* *:25,55:00
# 00:01 and 00:04 SAST: give a waiting request a chance at the daily reset.
OnCalendar=*-*-* 22:01,04:00 UTC
AccuracySec=5s
Persistent=true
Unit=cwhereu-viewer-requests.service

[Install]
WantedBy=timers.target
